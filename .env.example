# Local-only backend configuration. Do not use these values for a network deployment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=aucc
# Optional CA bundle for remote MySQL; server hostname verification stays enabled.
# DB_TLS_CA_FILE=/path/to/provider-ca.pem

# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Explicit first-time setup only. Disable and remove credentials after creation.
BOOTSTRAP_ADMIN=false
# A generated password must be >=15 characters and <=72 UTF-8 bytes.
SADMIN_USERNAME=
SADMIN_PASSWORD=
SELF_REGISTRATION_ENABLED=false

# New stations use one-time per-station credentials created in the Admin UI.
# Keep legacy auth disabled unless migrating old agents that still share AGENT_SECRET.
AGENT_SECRET=
ALLOW_LEGACY_AGENTS=false
AGENT_RELEASE_DIR=agent-releases
# Optional built frontend, relative to backend-go when launched there.
FRONTEND_DIST_DIR=

# Local browser trial only. Network deployment requires HTTPS/WSS and secure cookies.
HTTP_ADDR=127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=

TLS_CERT_FILE=
TLS_KEY_FILE=
