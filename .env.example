# Local-only backend configuration. Do not use these values for a network deployment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=aucc

# Generate a random value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Bootstrap account is created only when both values are set.
SADMIN_USERNAME=
SADMIN_PASSWORD=
SELF_REGISTRATION_ENABLED=false

# New stations use one-time per-station credentials created in the Admin UI.
# Keep legacy auth disabled unless migrating old agents that still share AGENT_SECRET.
AGENT_SECRET=
ALLOW_LEGACY_AGENTS=false

# Local browser trial only. Network deployment requires HTTPS/WSS and secure cookies.
HTTP_ADDR=127.0.0.1:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=

TLS_CERT_FILE=
TLS_KEY_FILE=
